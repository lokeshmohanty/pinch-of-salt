  "sources": [
    {
      "title": "U.S. managed $12 billion in Venezuelan oil revenue, State Department says",
      "link": "https://www.washingtonpost.com/world/2026/11/12/us-managed-12-billion-venezuela-oil-revenue-state-department-says/",
      "description": "Amid demands for transparency, the State Department released a report detailing the oil funds received by the United States and disbursed back to Venezuela.",
      "source_name": "Washington Post World",
      "published": "2026-11-12T22:40:00"
    },
    {
      "title": "US returns over $12 bn in oil proceeds to Venezuela since Maduro's ouster",
      "link": "https://www.business-standard.com/world-news/us-returns-over-12-bn-in-oil-proceeds-to-venezuela-since-maduro-s-ouster-126111300011_1.html",
      "description": "The Trump administration says it has returned more than USD 12 billion, or almost 99 per cent, of the revenue obtained from the sales of Venezuelan oil since it ousted then-President Nicolas Maduro in January.\nIn a report released Thursday by the State Department, the accounting firm KPMG said the sales of Venezuelan crude, along with minor amounts of gold, minerals and fertilizer, produced USD 12.26 billion. Almost all of the money has been returned to Venezuela under the terms of a broad energy deal reached with the country's interim authorities, according to the report.\nAs of Sept. 30, the end of the 2026 budget year, USD 168.6 million remained in an escrow account managed by the US Treasury Department, the report said.\nUnder the terms of the deal, Venezuelan crude is sold on the open market, with proceeds going into the US-managed account. Venezuelan officials then seek approval for those funds to be returned to the country to pay for infrastructure and humanitarian needs.\nThe",
      "source_name": "Business Standard Latest",
      "published": "2026-11-13T02:37:00"
    }
  ]
