    {
      "statement": "Long interspersed element-1 (LINE-1 or L1) retrotransposons are hypothesized to facilitate XCI.",
      "confidence": 0.95
    },
    {
      "statement": "The human X chromosome has a higher abundance of L1 retrotransposons compared to other eutherian chromosomes.",
      "confidence": 0.95
    }
