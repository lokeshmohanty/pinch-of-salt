  "title": "US government mislabels African countries during global conferences",
  "summary": "The US government mislabeled every country at a global conference in Brazil, causing widespread confusion among attendees, including those in Nigeria, and prompting a reaction from the news media.",
  "facts": [
    {
      "statement": "The US government map of Africa mislabeled every country during a state department presentation at a global conference in Brazil.",
      "confidence": 0.95
    },
    {
      "statement": "The map was corrected by the department, but it caused confusion among attendees.",
      "confidence": 0.95
    },
    {
      "statement": "Nigeria, a coastal country in western Africa, was incorrectly labeled as landlocked in the Sahara.",
      "confidence": 0.95
    }
