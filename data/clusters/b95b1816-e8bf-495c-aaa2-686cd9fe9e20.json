    {
      "title": "Maternity leave for third child of Tamil Nadu government employees raised to 365 days",
      "link": "https://www.thehindu.com/news/national/tamil-nadu/maternity-leave-for-third-child-of-women-government-employees-raised-to-365-days/article71360294.ece",
      "description": "Women government employees are now granted 365 days of maternity leave for their first two children, while those with two or more children are granted up to 12 weeks of maternity leave, points out Minister for Human Resources Management D. Sarathkumar",
      "source_name": "The Hindu National",
      "published": "2026-08-19T10:18:32"
    },
    {
      "title": "Tamil Nadu govt extends maternity leave for third child to 365 days",
      "link": "https://www.business-standard.com/india-news/tamil-nadu-govt-extends-maternity-leave-for-third-child-to-365-days-126081801314_1.html",
      "description": "The Tamil Nadu government on Tuesday announced extending the maternity leave for its women employees for the birth of their third child from 12 weeks to 365 days, the same duration that they get for the first two children.\nCurrently, married women government employees with fewer than two surviving children are granted 365 days of maternity leave, while those with two or more surviving children receive up to 12 weeks of maternity leave.\nDuring the demand for grants to his department, Minister for Human Resources Management, D Sarathkumar told the state Assembly, \"Under these circumstances, as the Tamil Nadu government is a welfare-oriented administration prioritising social welfare and women's empowerment, the maternity leave currently provided for the third child of female government employees will be enhanced from 12 weeks to 365 days\".\nThe original 90 days of maternity leave was raised to six months in 2011, nine months in 2016, and extended to one year (365 days) in July 2021 by",
      "source_name": "Business Standard Latest",
      "published": "2026-08-19T07:18:56"
    }
  ]
