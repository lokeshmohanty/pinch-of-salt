  "id": "44e577b2-d188-4dc7-8c71-b3dd2dc0d90f",
  "title": "GeoCo and FoMNet: Two Frameworks for 3D Scene and Video Generation",
  "summary": "GeoCo introduces a framework for 3D scene and video generation using a two-stage pipeline combining geometric modeling and latent geometry-guided diffusion, while FoMNet enhances cross-modal homography estimation through spatial adaptation and contextual matching.",
  "facts": [
    {
      "statement": "GeoCo-D outperforms all compared baselines while using 98.5% fewer parameters and 70.4% fewer FLOPs than the complete GeoCo teacher.",
      "confidence": 0.95
    },
    {
      "statement": "FoMNet achieves the lowest mean average corner error (MACE) among the evaluated methods, reducing MACE by 10.6%-72.7% relative to MCNet.",
      "confidence": 0.95
    },
    {
      "statement": "Both GeoCo and FoMNet use the lightweight RVHomo-D estimator for 3D scene and video generation.",
      "confidence": 0.95
    }
  ],
