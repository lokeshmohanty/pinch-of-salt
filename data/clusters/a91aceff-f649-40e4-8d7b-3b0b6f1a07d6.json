{
  "id": "a91aceff-f649-40e4-8d7b-3b0b6f1a07d6",
  "title": "Unified Backbone Refinement for Diffusion Models via Internal-Latent Analysis",
  "summary": "This paper presents a systematic analysis of diffusion components, introducing DUNE (Diffusion Unified Network Refiner) to detect and suppress artifacts in deep low-noise internal latents, with experiments across multiple backbones showing improved fidelity and reduced hallucinations.",
  "facts": [
    {
      "statement": "DUNE introduces a training-free refinement framework using shared EMA-based criteria to detect and suppress abrupt latents in diffusion models.",
      "confidence": 0.95
    },
    {
      "statement": "Experiments across multiple backbones demonstrate improved fidelity and reduced hallucinations through DUNE's approach.",
      "confidence": 0.95
    },
    {
      "statement": "The method leverages the same detect-suppress principle as U-Net and extends to Transformer-based diffusion models.",
      "confidence": 0.95
    }
  ],
