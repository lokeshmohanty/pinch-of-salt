  "id": "24bc83a4-5e96-423a-816f-4a6d158f62d0",
  "title": "SemantiScene-Edit and MarineLife-16K: A Fusion of Instruction-Based Video Editing and Marine Video Understanding",
  "summary": "SemantiScene-Edit introduces a multimodal video editor that enhances instruction-based editing by incorporating a pretrained video diffusion transformer with a joint encoder processing source and instruction, while MarineLife-16K provides a rich dataset of video-text pairs for motion-aware marine video understanding. Both datasets address limitations in existing approaches.",
  "facts": [
    {
      "statement": "SemantiScene-Edit couples a multimodal encoder with a pretrained video diffusion transformer, learning semantic context for instruction-guided editing.",
      "confidence": 0.95
    },
    {
      "statement": "MarineLife-16K features 13 attributes and 2,000 video-text pairs for motion-aware marine video understanding.",
      "confidence": 0.95
    },
    {
      "statement": "Both datasets are large-scale and include annotations for benchmarking video-LLM models.",
      "confidence": 0.95
    }
  ],
