  "sources": [
    {
      "title": "Jharkhand cancels 44 govt exams; 2,000 fear job loss: Check latest updates",
      "link": "https://www.business-standard.com/india-news/jharkhand-cancels-44-govt-exams-2-000-fear-job-loss-check-latest-updates-126081900440_1.html",
      "description": "Jharkhand govt has cancelled 44 exams and formed a 2-month reform panel, as appointees launch a counter-protest against exam cancellations; Devendra Mahto has said that the protest will continue",
      "source_name": "Business Standard Latest",
      "published": "2026-08-19T06:43:50"
    },
    {
      "title": "Jharkhand govt releases list of 44 exams cancelled due to irregularities",
      "link": "https://www.business-standard.com/india-news/jharkhand-govt-releases-list-of-44-exams-cancelled-due-to-irregularities-126081900017_1.html",
      "description": "The Jharkhand government on Tuesday night released a list of 44 recruitment exams that have been cancelled due to irregularities, amid student protests over the issue.\nIssuing eight notifications late at night, the Jharkhand government said the cancelled exams include those conducted by the Jharkhand Public Service Commission (JPSC) and outsourced agency TSR Data Processing Pvt Ltd (TDPL) since 2014.\nThe exams cancelled include recruitment for drug inspectors, assistant professors, deputy collectors, dental doctors, assistant engineers, civil judges, additional public prosecutors and forest range officers among others.\nThe state government, after a cabinet meeting on Monday, announced the cancellation of the JSSC-Combined Graduate Level (CGL) examination, one of the key demands of protesting students, as well as all examinations conducted by outsourced agency TDPL and the results published by it.",
      "source_name": "Business Standard Latest",
      "published": "2026-08-19T02:12:05"
    }
  ]
