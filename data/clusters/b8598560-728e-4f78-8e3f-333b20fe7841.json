  "id": "b8598560-728e-4f78-8e3f-333b20fe7841",
  "title": "GRC-ProbNet: Uncertainty-aware Feature Extraction for Cardiovascular Disease Classification",
  "summary": "GRC-ProbNet improves cardiovascular disease classification by integrating uncertainty features and hybrid pipelines, while leveraging deep ensembles to enhance segmentation accuracy and downstream performance.",
  "facts": [
    {
      "statement": "GRC-ProbNet introduces uncertainty-aware feature extraction to improve CVD classification AUROC (92.92%) compared to baseline models.",
      "confidence": 0.95
    },
    {
      "statement": "The model uses a deep ensemble to produce multiple segmentation masks, addressing segmentation ambiguity in cardiac anatomy.",
      "confidence": 0.95
    },
    {
      "statement": "Experiments on publicly available datasets demonstrate that uncertainty measures are not necessarily the strongest signal for downstream classification.",
      "confidence": 0.95
    }
  ],
