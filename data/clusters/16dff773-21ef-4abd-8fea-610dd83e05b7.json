{
  "id": "16dff773-21ef-4abd-8fea-610dd83e05b7",
  "title": "On-Policy Distillation and Quantization in Small Local Language Models",
  "summary": "On-policy distillation (OPD) improves language model performance by training on student-generated trajectories with teacher-supervised dense token-level supervision. Quantization of weights reduces memory and sensitivity but can introduce biases if done poorly. The experiments compare two approaches: 6-bit weights with 4-bit averaging and 8-bit weights with entropy-based decision-making. These methods aim to balance efficiency and model performance.",
  "facts": [
    {
      "statement": "On-policy distillation (OPD) improves a student language model by training on its own generated trajectories with supervision from a stronger teacher.",
      "confidence": 0.95
    },
    {
      "statement": "Local language models can save memory by storing weights in fewer bits (e.g., 6 or 8 bits) and reduce sensitivity to the order of answer options.",
      "confidence": 0.95
    },
    {
      "statement": "At 6-bit weights, the model achieves +1.8 (+2.5) points higher than fp16 and -0.7 (-1.1) points lower than 8-bit.",
      "confidence": 0.95
    }
  ],
  "geography": "Global",
  "category": "Technical",
