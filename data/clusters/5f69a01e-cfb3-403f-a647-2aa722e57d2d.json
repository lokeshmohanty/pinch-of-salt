  "id": "5f69a01e-cfb3-403f-a647-2aa722e57d2d",
  "title": "Harness Evolution in LLM Agents: A Behavior-Aware Framework",
  "summary": "Harness Evolution in LLM Agents: A Behavior-Aware Framework explores how model-harness co-evolution can enable recursive self-improvement in large language models. This framework addresses challenges in planning agents by leveraging behavior-aware learning and introduces a new approach for self-modifying agents.",
  "facts": [
    {
      "statement": "TinyAstral demonstrates harness evolution improves robot agents by transferring teacher's harness improvements to a compact agent with lower inference costs.",
      "confidence": 0.95
    },
    {
      "statement": "RoboArchitect automates harness design by observing robot rollouts, diagnosing failures, and iteratively improving the harness without updating weights.",
      "confidence": 0.95
    },
    {
      "statement": "Harness evolution enhances robot performance by increasing success rates in unseen tasks and environments.",
      "confidence": 0.95
    }
  ],
