  "title": "HAP and MI-DETR: Bridging Egocentric Head Motion Prediction and Infrared Target Detection",
  "summary": "HAP proposes a hand-driven active perception framework to predict human head motion, while MI-DETR enhances infrared small target detection by integrating motion cues with appearance features. Both frameworks address challenges in motion interpretation and target detection.",
  "facts": [
    {
      "statement": "HAP infers confidence for each target object from observed hand motion and object geometry.",
      "confidence": 0.95
    },
    {
      "statement": "MI-DETR explicitly models motion and integrates spatial and temporal information using RIMCA and PMI.",
      "confidence": 0.95
    },
    {
      "statement": "MI-DETR achieves improved detection performance on public datasets and the Bottle dataset.",
      "confidence": 0.95
    }
  ],
