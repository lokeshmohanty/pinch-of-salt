{
  "id": "b0b17014-6842-48c9-9ef6-e636bd179484",
  "title": "CoGoal3D: Collaborative 3D Object Detection Framework",
  "summary": "CoGoal3D introduces a novel collaborative 3D object detection framework that addresses the limitations of single-vehicle systems by integrating environmental features from multiple agents, while achieving state-of-the-art performance on real-world datasets.",
  "facts": [
    {
      "statement": "CoGoal3D combines a multiscale 3D-aware global fusion module with a 3D point reconstruction auxiliary task in a two-stage pipeline",
      "confidence": 0.95
    },
    {
      "statement": "It achieves 3D AP@0.7 improvements of 10.86%, 10.34%, and 10.18% on public real-world datasets",
      "confidence": 0.95
    },
    {
      "statement": "Extensive experiments demonstrate new state-of-the-art results on DAIR-V2X, V2V4Real, and V2X-Real datasets",
      "confidence": 0.95
    }
  ],
