    {
      "title": "Tata Steel plans hydrogen facility at Kalinganagar to cut carbon emissions",
      "link": "https://www.business-standard.com/companies/news/tata-steel-plans-hydrogen-facility-at-kalinganagar-to-cut-carbon-emissions-126111800997_1.html",
      "description": "Tata Steel has partnered with Utility Global to study a 10-tonne-per-day hydrogen facility using steel plant gases, aiming to reduce emissions without major infrastructure changes",
      "source_name": "Business Standard Latest",
      "published": "2026-11-18T12:15:42"
