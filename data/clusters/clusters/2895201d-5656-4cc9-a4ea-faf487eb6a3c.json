      "statement": "Jev is a new type of safety judge that generates no text or labels and provides a probability for each answer.",
      "confidence": 0.95
    },
    {
      "statement": "In controlled adversarial evaluations, Jev outperforms other safety judges in detecting and resisting specific attack types.",
      "confidence": 0.95
    },
    {
      "statement": "Jev is the fastest judge but flags the most benign requests.",
      "confidence": 0.95
    }
