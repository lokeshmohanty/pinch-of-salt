  "sources": [
    {
      "title": "Cabinet clears ₹14,500 crore VGF scheme for 92 GWh energy storage capacity",
      "link": "https://www.business-standard.com/india-news/cabinet-clears-14-500-crore-vgf-scheme-for-92-gwh-energy-storage-capacity-126110401643_1.html",
      "description": "The scheme will support 92 GWh of grid-scale energy storage capacity by FY31, including pumped storage and battery projects, with an estimated investment of ₹97,600 crore",
      "source_name": "Business Standard Latest",
      "published": "2026-11-04T13:26:08"
    },
    {
      "title": "Cabinet clears ₹14,500 cr funding scheme for battery energy storage systems",
      "link": "https://www.business-standard.com/industry/news/cabinet-clears-14-500-cr-funding-scheme-for-battery-energy-storage-systems-126110401014_1.html",
      "description": "The Union Cabinet on Wednesday approved Rs 14,500 crore in viability gap funding for 92 GWh of grid-scale energy storage systems between FY27 and FY31.\nThis development is significant given India's ambitious target of 500 GW of renewable energy by 2030.\nThe scheme is aimed at supporting the development of 92 GWh storage capacity across three technologies -- Battery Energy Storage System (30 GWh), Pumped Storage Projects (60 GWh) and Emerging Storage Technologies (2GW), Information and Broadcasting Minister Ashwini Vaishnaw said in a media briefing here.\nThe minister said the scheme will be implemented for five years till 2030-31.",
      "source_name": "Business Standard Latest",
      "published": "2026-11-04T10:12:51"
    }
  ]
