{
  "id": "f2f0d51f-e403-44f0-9c79-98a418e81b50",
  "title": "Unified 3D Gaussian Splatting Frameworks for Realistic Scene Reconstruction",
  "summary": "RealityBridge combines multimodal controls and lightweight GateNet to enhance 3DGS driving simulations, while the 4D radar-camera framework improves full-scene perception. Both methods address the need for efficient, accurate 3D reconstruction in autonomous driving and medical imaging.",
  "facts": [
    {
      "statement": "RealityBridge outperforms existing methods in safety and realism by integrating multimodal controls and lightweight GateNet for adaptive condition allocation.",
      "confidence": 0.95
    },
    {
      "statement": "The 4D radar-camera framework models semantic occupancy as a persistent scene state, enabling cross-modal state reasoning for 360° full-scene perception.",
      "confidence": 0.95
    }
  ],
