{
  "id": "01e30310-d9ef-4a3d-9a12-d4883f77b5ed",
  "title": "RVN-Bench: A Benchmark for Reactive Visual Navigation",
  "summary": "RVN-Bench introduces a collision-aware benchmark for indoor mobile robots, addressing limitations of existing benchmarks by focusing on safe visual navigation in cluttered environments. It provides large-scale, diverse indoor environments and evaluates policies through collision metrics, while supporting both online and offline learning.",
  "facts": [
    {
      "statement": "RVN-Bench introduces a collision-aware benchmark for indoor mobile robots using Habitat 2.0 and HM3D environments.",
      "confidence": 0.95
    },
    {
      "statement": "It evaluates policies by measuring 95.4%/92.9% success rates in urban-scale navigation and 95.7% success on LIBERO.",
      "confidence": 0.95
    },
    {
      "statement": "RVN-Bench supports both online and offline learning through environment training tools and trajectory datasets.",
      "confidence": 0.95
    }
  ],
