    {
      "title": "Nigel Farage to Speak at Reform UK Conference Amid Scrutiny Over Party Finances",
      "link": "https://www.nytimes.com/2026/09/04/world/europe/farage-reform-uk-conference-donations.html",
      "description": "Advisers to the Reform U.K. leader Nigel Farage were captured on film apparently arranging contributions from a man posing as a foreign donor.",
      "source_name": "NYT World News",
      "published": "2026-09-04T09:42:38"
    },
    {
      "title": "Argentina Is Ramping Up Its Claim to the Falklands. Here’s What to Know.",
      "link": "https://www.nytimes.com/article/falkland-islands-trump-uk-argentina-malvinas.html",
      "description": "President Javier Milei has dialed up Argentina’s claim over the British territory, while President Trump has raised questions about longstanding U.S. neutrality on the dispute.",
      "source_name": "NYT World News",
      "published": "2026-09-04T03:07:28"
    },
