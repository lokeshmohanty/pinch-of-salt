  "title": "TerraAgent: Demonstration-Grounded Multi-Agent Reasoning for Long-Context Remote Sensing Visual Question Answering",
  "summary": "TerraAgent introduces a framework to demonstrate grounded multi-agent reasoning for remote sensing visual question answering, addressing challenges in retrieving accurate evidence across varying ground sample distances and improving performance through structured reasoning and verification.",
  "facts": [
    {
      "statement": "TerraAgent introduces AVA, a training-free framework with modules for GDR, MACE, and CVA to improve accuracy and evidence support.",
      "confidence": 0.95
    },
    {
      "statement": "AVA improves average accuracy by up to 2.40 points and raises visual-dependency scores in benchmarks like RSVQA-LR/HR and LHRS-Bench.",
      "confidence": 0.95
    },
    {
      "statement": "The framework uses GSD-bucketed retrieval, evidence-typed sub-question DAGs, and shared evidence logs for verified provenance.",
      "confidence": 0.95
    }
  ],
