  "title": "Dual-Latent World Model (Dual-WM)",
  "summary": "The Dual-Latent World Model (Dual-WM) introduces a dual-latent architecture that separates local execution and long-range planning by using distinct state representations and dynamics models. This approach enables precise execution of actions while planning over longer temporal spans, improving performance in visual control tasks compared to existing methods.",
  "facts": [
    {
      "statement": "The Dual-Latent World Model (Dual-WM) separates local execution and long-range planning through distinct state representations and dynamics models.",
      "confidence": 0.95
    },
    {
      "statement": "The model uses a low-level prediction to generate actions, while the high-level model plans over longer temporal spans.",
      "confidence": 0.95
    },
    {
      "statement": "The Dual-WM outperforms existing methods in visual control tasks with improved mean success rates.",
      "confidence": 0.95
    }
