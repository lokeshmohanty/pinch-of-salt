  "id": "56b2ea71-da53-49cf-a2d2-0a05479e78bf",
  "title": "GeoWorld and VGGRPO: A Two-Stage Framework for 3D Scene and Video Generation",
  "summary": "GeoWorld proposes a two-stage pipeline for 3D scene generation, combining video generation and multi-view geometry modeling to produce full-frame geometric features. VGGRPO introduces a latent geometry-guided framework that extends to dynamic scenes by stitching diffusion latents with geometry models, improving geometric consistency and camera stability.",
  "facts": [
    {
      "statement": "GeoWorld achieves 7.5× faster video generation than Hunyuan-Voyager.",
      "confidence": 0.95
    },
    {
      "statement": "VGGRPO introduces a latent geometry model that directly decodes scene geometry from the latent space.",
      "confidence": 0.95
    },
    {
      "statement": "Both methods address geometric consistency in 3D and video generation, leveraging geometric constraints and latent space optimization.",
      "confidence": 0.95
    }
  ],
