    {
      "statement": "The court suspended the board of trustees of Arulmigu Subramaniaswamy temple and ordered the lighting of a lamp at Thiruparankundram Deepathoon.",
      "confidence": 0.95
    },
    {
      "statement": "The court directed Tamil Nadu's chief secretary to appear personally and file an affidavit detailing communications.",
      "confidence": 0.95
    }
