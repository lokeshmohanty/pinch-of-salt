  "id": "efa68390-3882-4504-b293-37f9defa8e79",
  "title": "Gaze World Model and GazeVLM: Efficient Gaze-Guided Vision-Language Models",
  "summary": "The Gaze World Model (GWM) introduces a novel framework for gaze-based inference in vision-language models (VLMs), improving shift detection and gaze localization. GazeVLM, a training-free framework, leverages human gaze to guide efficient inference, achieving significant computational efficiency and performance improvements over existing methods.",
  "facts": [
    {
      "statement": "The Gaze World Model (GWM) improves shift detection and gaze localization by co-training latent scene prediction with person-conditioned gaze supervision on a frozen V-JEPA 2.1 encoder.",
      "confidence": 0.95
    },
    {
      "statement": "GazeVLM achieves state-of-the-art results in shift detection and future gaze localization, outperforming existing image-based models by about 10 points in four-class AP benchmarks.",
      "confidence": 0.95
    },
    {
      "statement": "GazeVLM reduces visual tokens by up to 84.2% and prefill FLOPs by up to 92.8% while achieving 11.6 times prefill speedup.",
      "confidence": 0.95
    }
