{
  "id": "55a97d7b-2f3e-4b6f-b14c-8085071e6cf9",
  "title": "Unified 3D Semantic Occupancy Frameworks for Autonomous Driving and Medical Imaging",
  "summary": "The 4D radar-camera framework and the Unified 3D Gaussian Splatting Frameworks (U3GS) address the need for efficient, accurate 3D reconstruction in autonomous driving and medical imaging, while the SuperQuadricOcc model leverages superquadrics for real-time semantic occupancy estimation. Both frameworks improve full-scene perception and scene understanding.",
  "facts": [
    {
      "statement": "The 4D radar-camera framework models semantic occupancy as a persistent scene state, enabling cross-modal state reasoning for 360° full-scene perception.",
      "confidence": 0.95
    },
    {
      "statement": "RealityBridge combines multimodal controls and lightweight GateNet to enhance 3DGS driving simulations, while the 4D radar-camera framework improves full-scene perception.",
      "confidence": 0.95
    },
    {
      "statement": "SuperQuadricOcc introduces a self-supervised occupancy model using superquadrics for real-time inference with a reduced memory footprint.",
      "confidence": 0.95
    }
  ],
