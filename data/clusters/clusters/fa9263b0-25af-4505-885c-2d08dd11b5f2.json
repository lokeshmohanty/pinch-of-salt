  "id": "fa9263b0-25af-4505-885c-2d08dd11b5f2",
  "title": "Unified Event-Frame Sensors and CCD Noise Synthesis Frameworks",
  "summary": "Hybrid event-frame sensors combine an Event Vision Sensor (EVS) and an Active Pixel Sensor (APS) to achieve high dynamic range and low latency imaging, while a physics-based noise synthesis framework models photon shot noise, photo-response non-uniformity, dark-current noise, and readout effects to generate low-noise inputs for astronomical imaging. These approaches enable robust, noise-limited imaging and improve the efficiency of calibration and denoising processes.",
  "facts": [
    {
      "statement": "Hybrid event-frame sensors integrate an Event Vision Sensor (EVS) and an Active Pixel Sensor (APS) within a single chip.",
      "confidence": 0.95
    },
    {
      "statement": "The first unified statistics-based imaging noise model jointly describes noise behavior of APS and EVS pixels.",
      "confidence": 0.95
    },
    {
      "statement": "The noise model links EVS noise to illumination level and dark current, and incorporates photon shot noise, dark current noise, and quantization noise.",
      "confidence": 0.95
    }
