  "id": "eeff8ccc-5807-4ec6-b21e-57755d9f11c4",
  "title": "Asynchronous Perception Machine (APM) for Efficient Test-Time-Training",
  "summary": "APM introduces a computationally-efficient architecture for test-time-training (TTT) that processes image patches asymmetrically while encoding semantic-awareness, enabling out-of-distribution recognition without dataset-specific pre-training. It demonstrates APM's ability to scale to 2D datasets and validate GLOM's insight, offering competitive performance across TTT approaches.",
  "facts": [
    {
      "statement": "APM processes image patches one at a time in any order and encodes semantic-awareness without dataset-specific pre-training.",
      "confidence": 0.95
    },
    {
      "statement": "APM achieves 95.7% success on LIBERO with 0.5B parameters and 4.19 sequence length.",
      "confidence": 0.95
    },
    {
      "statement": "APM provides first empirical evidence for GLOM's insight, validating that input percept is a field.",
      "confidence": 0.95
    }
  ],
