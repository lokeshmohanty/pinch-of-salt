  "id": "fffc3264-f363-410b-af4b-cce0da7a638a",
  "title": "4D Radar-Camera Framework for Full-Scene Perception in Autonomous Driving",
  "summary": "This 4D radar-camera framework models semantic occupancy as a persistent scene state, enabling cross-modal state reasoning for 360° full-scene perception. It combines state-guided BEV enhancement and Doppler-guided temporal fusion to improve accuracy and robustness in autonomous driving scenarios.",
  "facts": [
    {
      "statement": "The 4D radar-camera framework integrates state reasoning to model semantic occupancy as a persistent scene state.",
      "confidence": 0.95
    },
    {
      "statement": "It uses cross-modal state reasoning to propagate occupancy information through stages for feature aggregation.",
      "confidence": 0.95
    },
    {
      "statement": "The framework achieves over 30% reduction in world-space pose error compared to existing methods.",
      "confidence": 0.95
    }
  ],
