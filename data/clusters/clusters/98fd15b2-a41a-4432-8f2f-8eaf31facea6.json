  "id": "98fd15b2-a41a-4432-8f2f-8eaf31facea6",
  "title": "GeoWorld and VGGRPO: A Two-Stage Framework for 3D Scene and Video Generation",
  "summary": "GeoWorld proposes a two-stage pipeline for 3D scene generation, combining video generation and multi-view geometry modeling to produce full-frame geometric features. VGGRPO introduces a latent geometry-guided framework that extends to dynamic scenes by stitching diffusion latents with geometry models, improving geometric consistency and camera stability.",
  "facts": [
    {
      "statement": "The GeoWorld framework combines video generation and multi-view geometry modeling to produce full-frame geometric features.",
      "confidence": 0.95
    },
    {
      "statement": "VGGRPO introduces a latent geometry-guided framework that improves geometric consistency and camera stability by stitching diffusion latents with geometry models.",
      "confidence": 0.95
    },
    {
      "statement": "The GeoWorld and VGGRPO frameworks address the need for dynamic and geometric consistency in 3D scene and video generation.",
      "confidence": 0.95
    }
  ],
