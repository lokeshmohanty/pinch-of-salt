  "id": "d9acaef5-646e-44e3-9210-b9670af91772",
  "title": "SADA-Merging and SERA: Spectrum-Aware and Depth-Adaptive Frameworks for Model Fusion",
  "summary": "SADA-Merging addresses the challenge of merging LoRA adapters by leveraging spectrum-aware and depth-adaptive techniques, while SERA proposes a task-adaptive energy-proportional rank allocation to optimize model fusion across different task scales. Both approaches aim to improve performance in data-free model merging by adapting to intrinsic geometric and spectral characteristics.",
  "facts": [
    {
      "statement": "SADA-Merging allocates task-specific subspace capacity according to spectral complexity and applies depth-dependent anchoring to compensate for projection-induced distortion.",
      "confidence": 0.95
    },
    {
      "statement": "SERA assigns spectral capacity to complex or isolated tasks and fewer directions to compact tasks to optimize the shared merging space.",
      "confidence": 0.95
    },
    {
      "statement": "Both SADA-Merging and SERA demonstrate improvements in performance across different task scales and adaptation settings.",
      "confidence": 0.95
    }
  ],
