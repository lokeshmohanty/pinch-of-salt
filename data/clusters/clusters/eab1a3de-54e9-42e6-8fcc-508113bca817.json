  "id": "eab1a3de-54e9-42e6-8fcc-508113bca817",
  "title": "Adaptive View Retrieval for Hidden Hateful Illusions",
  "summary": "Adaptive View Retrieval addresses hidden hate in multimodal systems by detecting optical illusions, improving accuracy with a perceptual retrieval framework, and surpassing previous baselines across different datasets and evaluation metrics. It also outperforms existing methods in terms of performance and accuracy.",
  "facts": [
    {
      "statement": "Adaptive View Retrieval achieves 93.2% balanced accuracy on HatefulIllusion with a frozen CLIP encoder.",
      "confidence": 0.95
    },
    {
      "statement": "It significantly outperforms original-view baselines and fixed single-transform filters across hate slangs, symbols, and visibility levels.",
      "confidence": 0.95
    },
    {
      "statement": "The same design surpasses official fine-tuned CLIP baselines and matches or exceeds human performance on IllusionMNIST, FashionMNIST, and AnimalsMNIST.",
      "confidence": 0.95
    }
  ],
