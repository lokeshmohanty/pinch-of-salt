    {
      "statement": "A chemical tanker carrying nine Indian seafarers was hit by a drone at an anchorage off Romania.",
      "confidence": 0.95
    },
    {
      "statement": "All crew members of the Indian seafarers on board were safe and the vessel reached the Port of Constanta.",
      "confidence": 0.95
    },
    {
