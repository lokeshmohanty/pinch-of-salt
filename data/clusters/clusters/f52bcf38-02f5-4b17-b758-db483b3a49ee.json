  "id": "f52bcf38-02f5-4b17-b758-db483b3a49ee",
  "title": "Deep Learning Estimation of Sex, Age, Height, and Weight from CT-derived DRRs",
  "summary": "This study presents a deep learning ensemble for estimating adult sex, age, height, and weight from CT-derived digitized radiographs, achieving high accuracy with lower errors in broader anatomical coverage. The framework uses three multitask models and combines them for improved performance.",
  "facts": [
    {
      "statement": "The study includes 128,621 CT examinations from 80,004 adults across nine institutions in Japan.",
      "confidence": 0.95
    },
    {
      "statement": "The ensemble achieved an overall sex-classification accuracy of 0.997 (95% CI, 0.996-0.998) in the test set.",
      "confidence": 0.95
    },
    {
      "statement": "The MAEs for age, height, and weight were 3.57 years, 2.59 cm, and 3.40 kg respectively.",
      "confidence": 0.95
    }
