    {
      "title": "Israel's election result is messy - here's why",
      "link": "https://www.bbc.co.uk/news/videos/c893zeknlvnno?at_medium=RSS&at_campaign=rss",
      "description": "Despite having the highest voter turnout in nearly three decades, Israel's elections have had no clear winner. What does this mean for the country, asks the BBC's Yolande Knell.",
      "source_name": "BBC World News",
      "published": "2026-10-28T14:26:24"
