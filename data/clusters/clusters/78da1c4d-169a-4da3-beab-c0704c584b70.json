    {
      "title": "Jantar Mantar de-notified as protest site: A history of Delhi's dissent hub",
      "link": "https://www.business-standard.com/india-news/jantar-mantar-de-notified-as-protest-site-a-history-of-delhi-s-dissent-hub-126101200751_1.html",
      "description": "After over 3 decades as a hub for dissent, Jantar Mantar has been de-notified as a protest venue, with Ramlila Ground, Burari Ground and CBD Ground designated as alternative sites for demonstrations",
      "source_name": "Business Standard Latest",
      "published": "2026-10-12T11:40:01"
