    {
      "statement": "RL-VLA$^3$ achieves up to 85.2% throughput improvements over synchronous baselines while maintaining identical sample efficiency.",
      "confidence": 0.95
    },
    {
      "statement": "RL-VLA$^3$ is the first fully asynchronous RL training framework tailored specifically for the system-level challenges of VLA training.",
      "confidence": 0.95
    }
