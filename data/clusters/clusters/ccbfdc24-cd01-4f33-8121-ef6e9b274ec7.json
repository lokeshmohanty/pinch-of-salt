{
  "id": "ccbfdc24-cd01-4f33-8121-ef6e9b274ec7",
  "title": "NaviCache: Test-Time Self-Calibration for Video Generation",
  "summary": "NaviCache re-conceptualizes feature evolution as an Inertial Navigation System (INS) problem, bridging the fundamental domain gap and non-stationary diffusion by modeling relative coupling between input and output variations. It introduces a dual-state estimation architecture for error-bounded computation skipping, achieving superior performance across video generation benchmarks.",
  "facts": [
    {
      "statement": "NaviCache bridges the fundamental domain gap and the non-stationary nature of diffusion by modeling the relative coupling between input and output variations.",
      "confidence": 0.95
    },
    {
      "statement": "It introduces a dual-state estimation architecture that adaptively tracks the feature change ratio and its latent drift, initialized via a specialized Initial Alignment phase.",
      "confidence": 0.95
    },
    {
      "statement": "Extensive experiments on the HunyuanVideo, Wan, and Open-Sora series demonstrate that NaviCache exhibits more accurate error judgment for computation skipping and achieves outstanding comprehensive performance.",
      "confidence": 0.95
    }
  ],
