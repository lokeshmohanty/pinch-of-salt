  "id": "d97881e5-2f22-491d-830b-8410688ec599",
  "title": "Imagine3D-LLM and FusionBERT: Advances in 3D Scene Reasoning and Multimodal Retrieval",
  "summary": "Imagine3D-LLM introduces a method to teach MLLMs to imagine 3D scenes before answering, while FusionBERT enhances multi-view image--3D retrieval through cross-attention-based fusion and normal-aware 3D encoding.",
  "facts": [
    {
      "statement": "Imagine3D-LLM learns a compact 3D Gaussian Splatting representation from learned summary tokens.",
      "confidence": 0.95
    },
    {
      "statement": "FusionBERT improves 3D retrieval accuracy by integrating features from multi-view images of an object.",
      "confidence": 0.95
    },
    {
      "statement": "Both models outperform existing multimodal large models in both single-view and multi-view settings.",
      "confidence": 0.95
    }
  ],
