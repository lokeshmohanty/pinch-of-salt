  "id": "89e34551-5766-4243-ba78-5b20d7421ee1",
  "title": "MoTop and EmoZone-Talker: A Motion-Topological Framework for Micro AU Detection and Facial Expression Control",
  "summary": "MoTop introduces a motion-topological model for detecting micro AU (action units) in facial micro-expressions, while EmoZone-Talker addresses spatial and temporal conflicts in audio-driven facial expression control through a structured approach.",
  "facts": [
    {
      "statement": "MoTop improves AU detection by enhancing spatial proximity and low-intensity dynamics through facial landmark transitions and anatomical clusters.",
      "confidence": 0.95
    },
    {
      "statement": "EmoZone-Talker introduces SZ-PAB and CIT-AE to model spatial and temporal coordination of facial motion, leading to improved expression controllability and realism.",
      "confidence": 0.95
    }
