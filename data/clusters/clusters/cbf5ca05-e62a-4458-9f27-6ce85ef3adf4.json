    },
    {
      "statement": "EEG-VID uses an exponential-moving-average target encoder for future latent prediction and supervised fine-tuning.",
      "confidence": 0.95
    },
    {
      "statement": "EEG-VID improves mean accuracy in 41 out of 42 matched backbone-dataset-protocol comparisons.",
      "confidence": 0.95
