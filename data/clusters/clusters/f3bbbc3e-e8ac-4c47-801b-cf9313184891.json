    {
      "title": "Centre constitutes social security board for gig, unorganised workers",
      "link": "https://www.business-standard.com/industry/news/centre-constitutes-social-security-board-for-gig-unorganised-workers-126103001418_1.html",
      "description": "The three-year board will advise the Centre on welfare schemes for gig, platform and unorganised workers, with representatives from aggregators, trade unions and state governments.",
      "source_name": "Business Standard Latest",
      "published": "2026-10-30T12:41:18"
    },
    {
      "title": "Centre notifies National Social Security Board for gig, platform workers",
      "link": "https://www.business-standard.com/economy/news/centre-notifies-national-social-security-board-for-gig-platform-workers-126103000557_1.html",
      "description": "The government has notified the National Social Security Board for unorganised workers and gig and platform workers, which will design, monitor, and recommend targeted welfare schemes to bridge the social security gap.\nGig workers are those who perform work or participate in a work arrangement and earn from such activities outside the traditional employer-employee relationship.\nPlatform workers are those who engage in work through or with online platforms.\nIn a move towards ensuring comprehensive social security for India's massive informal workforce, the Ministry of Labour & Employment has notified the constitution of the National Social Security Board for Unorganised Workers and Gig & Platform Workers, a ministry statement said.\nEstablished under the statutory framework of the Code on Social Security, this marks a historic shift by integrating digital gig and platform professionals into India's formal welfare architecture, the ministry said.\nThe Board will be presided over ..",
      "source_name": "Business Standard Latest",
      "published": "2026-10-30T07:09:35"
    }
  ]
