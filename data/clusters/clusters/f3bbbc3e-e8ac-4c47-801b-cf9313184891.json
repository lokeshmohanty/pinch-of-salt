  "title": "National Social Security Board for Unorganised Workers and Gig & Platform Workers",
  "summary": "The Ministry of Labour & Employment has established a National Social Security Board for Unorganised Workers and Gig & Platform Workers to design, monitor, and recommend targeted welfare schemes to bridge the social security gap. The Board will be presided over by a committee of experts from various sectors.",
  "facts": [
    {
      "statement": "The Ministry of Labour & Employment has notified the constitution of the National Social Security Board for Unorganised Workers and Gig & Platform Workers.",
      "confidence": 0.95
    },
    {
      "statement": "The Board will be presided over by a committee of experts from various sectors.",
      "confidence": 0.95
    },
    {
      "statement": "The Board will be established under the statutory framework of the Code on Social Security.",
      "confidence": 0.95
    }
  ],
