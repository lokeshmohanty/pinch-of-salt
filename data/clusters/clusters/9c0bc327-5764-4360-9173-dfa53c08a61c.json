  "id": "9c0bc327-5764-4360-9173-dfa53c08a61c",
  "title": "Decoupled Pipeline for Positive-Unlabeled Marine Species Detection",
  "summary": "A decoupled pipeline with proposal reranking and score fusion for positive-unlabeled marine species detection was developed for the FathomNetCLEF 2026 competition, addressing challenges like sparse training labels and out-of-distribution test data. The system uses a frozen detector, LoRA-finetuned classifier, and geometric fusion to improve model performance and validation.",
  "facts": [
    {
      "statement": "The system uses a frozen Megalodon YOLOv8x detector as a class-agnostic proposal generator.",
      "confidence": 0.95
    },
    {
      "statement": "It combines global and tiled inference with tile-edge filtering to improve detection accuracy.",
      "confidence": 0.95
    },
    {
      "statement": "The final private-leaderboard model achieves 12th place in the competition with weighted geometric fusion of detector and classifier confidence.",
      "confidence": 0.95
    }
  ],
