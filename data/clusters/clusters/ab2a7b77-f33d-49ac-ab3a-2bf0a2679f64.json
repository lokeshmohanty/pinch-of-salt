      "statement": "CrossRAG integrates Shape-Aware Memory (SAM) with RevIN normalization for magnitude-robust shape-level retrieval",
      "confidence": 0.95
    },
    {
      "statement": "TimeRFT introduces quality-aware temporal reward mechanisms and difficulty-aware data selection for improved adaptation",
      "confidence": 0.95
    },
    {
      "statement": "Experiments on seven public benchmarks show that TimeRFT consistently outperforms SFT-based methods",
      "confidence": 0.95
    }
