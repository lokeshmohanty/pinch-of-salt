  "title": "Government removes 12-minute ad duration cap for TV channels",
  "summary": "The government has removed a 12-minute ad duration cap for TV channels, citing increased competition and the need to address the effectiveness of existing regulations.",
  "facts": [
    {
      "statement": "The government removed the 12-minute ad duration cap for TV channels.",
      "confidence": 0.95
    },
    {
      "statement": "The cap was introduced in 2006 and was deemed outdated due to increased competition in the industry.",
      "confidence": 0.95
    },
    {
      "statement": "The decision aims to improve the effectiveness of current regulations by allowing for more diverse ad content and viewing options",
      "confidence": 0.95
    }
  ],
