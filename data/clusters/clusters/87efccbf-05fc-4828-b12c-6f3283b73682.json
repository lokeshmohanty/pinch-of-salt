  "sources": [
    {
      "title": "Supreme Court halts HC proceedings against Rahul Gandhi in disproportionate assets case",
      "link": "https://www.thehindu.com/news/national/supreme-court-halts-hc-proceedings-against-rahul-gandhi-in-disproportionate-assets-case/article71355349.ece",
      "description": "“If the courts want to issue directions [for inquiry/investigation], the courts are expected to fulfill the principles of natural justice,” Chief Justice Kant addressed the CBI counsel, Additional Solicitor General S.V. Raju.",
      "source_name": "The Hindu National",
      "published": "2026-08-17T10:26:52"
    },
    {
      "title": "SC asks Allahabad HC not to proceed with DA case against Rahul Gandhi",
      "link": "https://www.business-standard.com/india-news/sc-asks-allahabad-hc-not-to-proceed-with-da-case-against-rahul-gandhi-126081700496_1.html",
      "description": "In a relief to Rahul Gandhi, the Supreme Court on Monday asked the Allahabad High Court not to proceed with a disproportionate assets case against the Congress leader.\nThe top court also asked the CBI and the ED not to file any report before the high court in connection with the case lodged against the Leader of Opposition in the Lok Sabha.\nA bench comprising Chief Justice Surya Kant and Justices Joymalya Bagchi and V Mohana took note of the submissions of senior advocate Kapil Sibal, appearing for Gandhi, and issued notices to Karnataka resident S Vignesh Shishir, who had filed the plea in the high court, the CBI and the ED.\nThe bench was hearing a plea filed by Gandhi against the high court order.",
      "source_name": "Business Standard Latest",
      "published": "2026-08-17T07:40:50"
    }
  ]
