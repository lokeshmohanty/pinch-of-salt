    {
      "statement": "The protests were criticized by the government for their potential to disrupt public order and political stability.",
      "confidence": 0.95
    },
    {
      "statement": "The Supreme Court dismissed a plea against the protesters' actions, emphasizing judicial oversight.",
      "confidence": 0.95
    }
