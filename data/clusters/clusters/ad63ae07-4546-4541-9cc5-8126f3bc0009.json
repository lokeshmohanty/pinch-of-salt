{
  "id": "ad63ae07-4546-4541-9cc5-8126f3bc0009",
  "title": "Posterior Flow Matching",
  "summary": "Posterior Flow Matching (PFM) is a generative modeling framework that learns conditional velocity means and componentwise variances with a Gaussian posterior model, providing both transport prediction and endpoint uncertainty. This model enables mean-driven ODE and posterior-driven SDE generation, improving generation quality and endpoint-posterior diagnostics. Posterior-Averaged Bellman Flow Matching (PA-BFM) enhances flow-based distributional critics by using a bridge state that averages multiple Bellman endpoints.",
  "facts": [
    {
      "statement": "Flow matching learns how to transport noise toward data, but its mean prediction does not directly report the endpoint uncertainty remaining at an intermediate state.",
      "confidence": 0.95
    },
    {
      "statement": "Posterior Flow Matching (PFM) introduces a general generative modeling framework with Gaussian posterior models for conditional velocity means and componentwise variances.",
      "confidence": 0.95
    },
    {
      "statement": "Posterior-Averaged Bellman Flow Matching (PA-BFM) improves generation quality and provides endpoint-posterior diagnostics by using a bridge state that averages multiple Bellman endpoints.",
