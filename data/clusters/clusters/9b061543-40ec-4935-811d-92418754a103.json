  "id": "9b061543-40ec-4935-811d-92418754a103",
  "title": "Cowork-Gym and WorkRover: A Framework for Scaling Long-Horizon Cowork Agent Training",
  "summary": "Cowork-Gym and WorkRover both introduce scalable frameworks for training long-horizon cowork agents by enabling dynamic environment evolution and iterative refinement. Cowork-Gym leverages a build-execute-revise loop to maintain consistency across environments, while WorkRover focuses on harness-driven synthesis and dependency-closed replay for better training efficiency.",
  "facts": [
    {
      "statement": "Cowork-Gym introduces a framework for synthesizing interactive work environments at scale using execution evidence and feedback.",
      "confidence": 0.95
    },
    {
      "statement": "WorkRover enables long-horizon training through recursive environment evolution, improving training efficiency by 26.27 percentage points on JobBench and 413.25 Elo points on GDPval v2.",
      "confidence": 0.95
    },
    {
      "statement": "Both frameworks use Factorial Compatibility Replay (FCR) and Verifier-to-Turn Credit Assignment (VTCA) to enhance agent performance and training signals.",
      "confidence": 0.95
    }
  ],
