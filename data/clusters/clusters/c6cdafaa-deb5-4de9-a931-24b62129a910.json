  "title": "Synthetic Data Generation for LLMs: Privacy-Preserving and Utility-Optimized Approaches",
  "summary": "PromptGraph introduces a graph-guided prompt-sanitization approach to balance privacy and utility in LLM inference, while RPSG uses private seeds and differential privacy to generate realistic synthetic data for private text replicas. Both methods focus on preserving LLMs' utility while addressing privacy challenges.",
  "facts": [
    {
      "statement": "PromptGraph balances privacy and utility by estimating privacy leakage at span levels and penalizing contextual dependencies.",
      "confidence": 0.95
    },
    {
      "statement": "RPSG employs private seeds and differential privacy to generate synthetic data that preserves privacy while maintaining high fidelity to private data.",
      "confidence": 0.95
    }
  ],
