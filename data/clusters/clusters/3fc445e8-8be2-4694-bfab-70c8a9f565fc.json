  "id": "3fc445e8-8be2-4694-bfab-70c8a9f565fc",
  "title": "OPD-IAD: Leveraging Language for Industrial Anomaly Detection via On-Policy Distillation",
  "summary": "This report introduces an evidence-privileged dense on-policy self-distillation framework for large vision-language models (LVLMs) to achieve precise pixel-level localization in industrial anomaly detection (IAD), with language guiding the visual response.",
  "facts": [
    {
      "statement": "OPD-IAD uses language as a semantic condition for dense anomaly perception.",
      "confidence": 0.95
    },
    {
      "statement": "The framework learns privileged defect evidence onto the model's own on-policy trajectory for dense supervision.",
      "confidence": 0.95
    },
    {
      "statement": "Extensive experiments show OPD-IAD achieves state-of-the-art performance on pixel-level and QA metrics.",
      "confidence": 0.95
    }
  ],
