{
  "id": "d6d8a1ed-699f-44a6-956d-270a81b2ee1c",
  "title": "AI Frameworks for 3D Closed-Loop Manipulation",
  "summary": "Action Map Policy (AMP) introduces a pixel-classified approach to 3D closed-loop manipulation, leveraging image space classification to address high-dimensional action spaces, while achieving high success rates and efficiency. This method enables millimeter-level precision and supports real-time action prediction.",
  "facts": [
    {
      "statement": "AMP achieves 95.7% success on LIBERO with 0.5B parameters and 4.19 sequence length.",
      "confidence": 0.95
    },
    {
      "statement": "The method projects 3D actions onto camera planes and treats pixel locations as discrete classes to control dimensionality.",
      "confidence": 0.95
    },
    {
      "statement": "AMP demonstrates faster inference and enhanced spatial reasoning compared to diffusion policies.",
      "confidence": 0.95
    }
  ],
