  "id": "8ff620ce-b375-4516-9893-8a458391869a",
  "title": "SWITi: Quantifying and Reducing Tiling Artifacts with Sliding Window Inner Tiling",
  "summary": "SWITi is a test-time method for reducing artifacts in tiled predictions, particularly for neural networks that learn posterior distributions from which solutions are sampled at inference time. It averages overlapping sliding-window predictions to spread discrepancies across shifted tile positions, and reduces tiling artifacts by using reference-free metrics to quantify their impact.",
  "facts": [
    {
      "statement": "SWITi uses no more tile samples than an MMSE estimate requires and incurs no additional forward passes.",
      "confidence": 0.95
    },
    {
      "statement": "SWITi introduces two reference-free metrics, Fraction of Rejected Tests (FRT) and Artifact Severity (ASV), for detecting and quantifying tiling artifacts.",
      "confidence": 0.95
    },
    {
      "statement": "On pre-trained and published image splitting models across three fluorescence microscopy datasets in 2D and 3D, SWITi significantly reduces stitching seams while improving reconstruction fidelity and resolution.",
      "confidence": 0.95
    }
  ],
