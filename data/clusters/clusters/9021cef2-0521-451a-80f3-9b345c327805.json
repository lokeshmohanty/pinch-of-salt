  "id": "9021cef2-0521-451a-80f3-9b345c327805",
  "title": "PhenoEmbed: Self-Supervised Multispectral UAV Time-Series Embeddings for Individual Tree Crown Phenology",
  "summary": "PhenoEmbed, a self-supervised model trained on HeideBench for forest crown phenology, leverages temporal embeddings to capture seasonal changes in tree crowns, achieving 25.1% variance explained and 94.6% cosine similarity with nearest neighbors. It bridges heterogeneity in wireless sensing by decoupling sensor data from hardware constraints.",
  "facts": [
    {
      "statement": "PhenoEmbed uses contrastive and masked reconstruction objectives to learn compact nearest-neighbor structures.",
      "confidence": 0.95
    },
    {
      "statement": "The model's first two principal components explain 25.1% of variance and achieve 94.6% cosine similarity with nearest neighbors.",
      "confidence": 0.95
    }
  ],
