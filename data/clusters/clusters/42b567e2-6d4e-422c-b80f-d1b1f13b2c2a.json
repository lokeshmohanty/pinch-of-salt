  "title": "NASA JPL Tests Voyager Technologies' Lunar Lander for Moon Mission",
  "summary": "NASA JPL tests a lunar lander from Voyager Technologies for a mission to establish a human presence on the Moon, with simulations of harsh conditions and potential challenges.",
  "facts": [
    {
      "statement": "Voyager Technologies’ lunar lander completed nearly three months of environmental testing at NASA’s Jet Propulsion Laboratory in Southern California.",
      "confidence": 0.95
    },
    {
      "statement": "The tests simulate extreme temperatures, vacuum, and intense shaking, as part of the spacecraft’s preparation for the Moon mission.",
      "confidence": 0.95
    },
    {
      "statement": "The final trial was conducted to ensure the lander is ready for its journey to the Moon and landing on the surface.",
      "confidence": 0.95
    }
  ],
