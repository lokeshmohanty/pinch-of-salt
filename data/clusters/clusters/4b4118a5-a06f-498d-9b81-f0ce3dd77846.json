{
  "id": "4b4118a5-a06f-498d-9b81-f0ce3dd77846",
  "title": "You Only Reprogram Once: Rethinking Prolonged Training for Visual Reprogramming and Reparameterized Inter-Class Visual Reprogramming",
  "summary": "You Only Reprogram Once (YORO) introduces a parameter-efficient method for visual reprogramming by modeling the frozen response space as a downstream predictor without requiring prompt optimization. RVP proposes structured visual reprogramming by aggregating text prompts within classes and applying residual corrections across classes, achieving comparable or better performance.",
  "facts": [
    {
      "statement": "YORO constructs a downstream predictor from the frozen response space in a single forward-only traversal, achieving strong downstream predictions without prompt optimization.",
      "confidence": 0.95
    },
    {
      "statement": "RVP uses only a single visual prompt and can be reparameterized at inference into a frozen backbone followed by a linear classifier, incurring nearly zero computational overhead.",
      "confidence": 0.95
    },
    {
      "statement": "Across 11 few-shot classification benchmarks and four CLIP backbones, RVP consistently improves over prior visual reprogramming methods with comparable or better inference efficiency.",
      "confidence": 0.95
    }
  ],
