  "id": "90f345c6-958a-4367-8ea7-54a4ca411e12",
  "title": "HandFlow: Fully Generative 4D Hand Recovery with Flow Matching",
  "summary": "HandFlow introduces a fully generative flow-matching framework for temporally coherent 3D hand pose and shape estimation from monocular video, achieving state-of-the-art performance by leveraging discriminative regressors and generative modeling. It reduces world-space pose error by over 30% compared to the strongest baseline while maintaining competitive per-frame accuracy.",
  "facts": [
    {
      "statement": "HandFlow uses a Flux-style dual-stream transformer to capture long-range dependencies without autoregressive decoding",
      "confidence": 0.95
    },
    {
      "statement": "It employs a confidence-aware continuous masking mechanism to handle noisy or missing observations",
      "confidence": 0.95
    },
    {
      "statement": "Experiments on DexYCB and HOT3D show HandFlow outperforms existing methods in world-space accuracy and temporal smoothness",
      "confidence": 0.95
    }
  ],
